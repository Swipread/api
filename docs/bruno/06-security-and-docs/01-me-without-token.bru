meta {
  name: Me without token (401)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/me
  body: none
  auth: none
}

tests {
  test("401 avec WWW-Authenticate", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("www-authenticate")).to.contain("Bearer");
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
  });
}
