meta {
  name: Resend same batch (deduplicated)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/events
  body: json
  auth: inherit
}

body:json {
  {
    "sessionId": "{{sessionId}}",
    "events": [
      {
        "eventId": "{{viewEventId}}",
        "type": "view",
        "articleId": "{{articleId}}",
        "requestId": "{{requestId}}",
        "position": {{position}},
        "occurredAt": "{{viewAt}}",
        "payload": { "dwellMs": 4200 }
      },
      {
        "eventId": "{{saveEventId}}",
        "type": "save",
        "articleId": "{{articleId}}",
        "requestId": "{{requestId}}",
        "position": {{position}},
        "occurredAt": "{{saveAt}}"
      }
    ]
  }
}

tests {
  test("202, tout est reconnu comme doublon", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getBody()).to.deep.equal({ accepted: 0, duplicates: 2 });
  });
}
