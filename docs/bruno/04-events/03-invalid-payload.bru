meta {
  name: Invalid payload (400)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/events
  body: json
  auth: inherit
}

body:json {
  {
    "sessionId": "{{sessionId}}",
    "events": [
      {
        "eventId": "e_invalid",
        "type": "read",
        "articleId": "{{articleId}}",
        "occurredAt": "{{viewAt}}",
        "payload": { "readMs": 1000, "scrollDepth": 3 }
      }
    ]
  }
}

tests {
  test("400 qui explique le champ invalide", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    expect(res.getBody().detail).to.equal("Event e_invalid (read): scrollDepth must be between 0 and 1");
  });
}
