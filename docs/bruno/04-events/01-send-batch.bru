meta {
  name: Send batch (view + save)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/events
  body: json
  auth: inherit
}

body:json {
  {
    "sessionId": "{{sessionId}}",
    "events": [
      {
        "eventId": "{{viewEventId}}",
        "type": "view",
        "articleId": "{{articleId}}",
        "requestId": "{{requestId}}",
        "position": {{position}},
        "occurredAt": "{{viewAt}}",
        "payload": { "dwellMs": 4200 }
      },
      {
        "eventId": "{{saveEventId}}",
        "type": "save",
        "articleId": "{{articleId}}",
        "requestId": "{{requestId}}",
        "position": {{position}},
        "occurredAt": "{{saveAt}}"
      }
    ]
  }
}

script:pre-request {
  const now = Date.now();
  bru.setVar("viewEventId", `e_view_${now}`);
  bru.setVar("saveEventId", `e_save_${now}`);
  bru.setVar("viewAt", new Date(now - 2000).toISOString());
  bru.setVar("saveAt", new Date(now - 1000).toISOString());
}

tests {
  test("202, les deux événements sont acceptés", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getBody()).to.deep.equal({ accepted: 2, duplicates: 0 });
  });
}
