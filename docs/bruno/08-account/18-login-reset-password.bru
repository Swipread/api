meta {
  name: Login with the reset password
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}-reset"
  }
}

tests {
  test("200 pour le même utilisateur", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().userId).to.equal(bru.getVar("userId"));
    bru.setVar("accessToken", res.getBody().accessToken);
  });
}
