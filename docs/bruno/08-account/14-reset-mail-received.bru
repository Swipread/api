meta {
  name: Reset mail received (Mailpit)
  type: http
  seq: 14
}

get {
  url: {{mailpitUrl}}/api/v1/search?query={{mailQuery}}
  body: none
  auth: none
}

script:pre-request {
  // Encodée : le + des adresses de test serait lu comme une espace
  bru.setVar("mailQuery", encodeURIComponent(`to:"${bru.getVar("email")}" subject:"Choisissez un nouveau mot de passe"`));
  await new Promise(resolve => setTimeout(resolve, 2000));
}

tests {
  test("un mail avec le lien reçu", function () {
    expect(res.getStatus()).to.equal(200);
    const messages = res.getBody().messages;
    expect(messages).to.have.lengthOf(1);
    bru.setVar("resetMailId", messages[0].ID);
  });
}
