meta {
  name: Reset password with a used link (400)
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/v1/auth/password/reset
  body: json
  auth: none
}

body:json {
  {
    "token": "{{resetToken}}",
    "newPassword": "{{password}}-again"
  }
}

tests {
  test("400", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
