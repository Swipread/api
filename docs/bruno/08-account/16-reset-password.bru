meta {
  name: Reset password
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/v1/auth/password/reset
  body: json
  auth: none
}

body:json {
  {
    "token": "{{resetToken}}",
    "newPassword": "{{password}}-reset"
  }
}

tests {
  test("204, sans jeton d'accès", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Ferme toutes les sessions du compte et envoie un avis ; ne connecte pas.
}
