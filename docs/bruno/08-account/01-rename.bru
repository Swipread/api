meta {
  name: Change display name
  type: http
  seq: 1
}

patch {
  url: {{baseUrl}}/v1/me
  body: json
  auth: inherit
}

body:json {
  {
    "displayName": "Renamed"
  }
}

tests {
  test("200 avec le nouveau nom", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().displayName).to.equal("Renamed");
    expect(res.getBody().id).to.equal(bru.getVar("userId"));
  });
}
