meta {
  name: Login with the old password (401)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

tests {
  test("401", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
