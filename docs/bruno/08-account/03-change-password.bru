meta {
  name: Change password
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/v1/auth/password
  body: json
  auth: inherit
}

body:json {
  {
    "currentPassword": "{{password}}",
    "newPassword": "{{password}}-new"
  }
}

tests {
  test("204", function () {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  Ferme les sessions des autres appareils (leurs refresh tokens) ; celle du cookie envoyé avec la requête reste ouverte.
}
