meta {
  name: Change password with a wrong current password (400)
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/v1/auth/password
  body: json
  auth: inherit
}

body:json {
  {
    "currentPassword": "not-my-password",
    "newPassword": "{{password}}-new"
  }
}

tests {
  test("400 sur le champ currentPassword, code WrongPassword", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().errors[0].field).to.equal("currentPassword");
    expect(res.getBody().errors[0].code).to.equal("WrongPassword");
  });
}
