meta {
  name: Password change notice received (Mailpit)
  type: http
  seq: 11
}

get {
  url: {{mailpitUrl}}/api/v1/search?query={{mailQuery}}
  body: none
  auth: none
}

script:pre-request {
  // Encodée : le + des adresses de test serait lu comme une espace
  bru.setVar("mailQuery", encodeURIComponent(`to:"${bru.getVar("email")}" subject:"Votre mot de passe a été modifié"`));
  await new Promise(resolve => setTimeout(resolve, 2000));
}

tests {
  test("un mail prévient du changement", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().messages).to.have.lengthOf(1);
  });
}
