meta {
  name: Forgot password for an unknown address (202)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/auth/password/forgot
  body: json
  auth: none
}

body:json {
  {
    "email": "nobody-{{email}}"
  }
}

tests {
  test("202, comme pour une adresse inscrite", function () {
    expect(res.getStatus()).to.equal(202);
  });
}

docs {
  La réponse ne dit pas si l'adresse a un compte ; aucun mail n'est envoyé.
}
