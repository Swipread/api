meta {
  name: Reactivate source
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/v1/admin/sources/{{sampleSourceId}}
  body: json
  auth: inherit
}

body:json {
  {
    "active": true
  }
}

tests {
  test("200, source de nouveau active", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().active).to.equal(true);
  });
}
