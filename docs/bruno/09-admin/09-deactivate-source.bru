meta {
  name: Deactivate source
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/v1/admin/sources/{{sampleSourceId}}
  body: json
  auth: inherit
}

body:json {
  {
    "active": false
  }
}

tests {
  test("200, source inactive", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().active).to.equal(false);
  });
}
