meta {
  name: Create source with an unknown topic (400)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/v1/admin/sources
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Thème inconnu",
    "siteUrl": "https://example.net",
    "feedUrl": "https://example.net/rss",
    "language": "fr",
    "topicIds": [999999]
  }
}

tests {
  test("400, thème inconnu", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().detail).to.equal("Unknown topic ids: [999999]");
  });
}
